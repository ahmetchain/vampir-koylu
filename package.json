{
  "name": "vampir-koylu",
  "version": "2.0.0",
  "description": "Arkadaşlarla tarayıcıdan oynanan Vampir Köylü oyunu",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "build": "esbuild client/world/index.js --bundle --format=iife --global-name=VKWorld --minify --target=es2019 --outfile=public/build/world.js",
    "build:watch": "esbuild client/world/index.js --bundle --format=iife --global-name=VKWorld --sourcemap=inline --target=es2019 --outfile=public/build/world.js --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pg-mem": "^3.0.14",
    "socket.io-client": "^4.8.1",
    "three": "^0.187.0"
  }
}
